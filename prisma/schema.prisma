generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/** Workspace único del tablero (un proyecto = un tenant). */
model Tenant {
  id                    String      @id @default(uuid())
  name                  String
  slug                  String      @unique
  e2ePublicToken        String?     @unique
  e2ePublicPasswordHash String?
  e2eQaTasks            E2eQaTask[]
  createdAt             DateTime    @default(now())
}

model E2eQaTask {
  id              String   @id @default(uuid())
  tenantId        String
  externalId      Int
  actividad       String
  responsable     String
  flujo           String
  fechaInicio     String
  nuevaFecha      String   @default("")
  estatus         String   @default("")
  comentarios     String   @default("")
  personaAsignada String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalId])
  @@index([tenantId, fechaInicio])
  @@index([tenantId, estatus])
}
