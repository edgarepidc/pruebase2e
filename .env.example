# Supabase Postgres — Transaction pooler :6543 en Vercel
DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Tras el primer deploy en Vercel
NEXT_PUBLIC_APP_URL="https://tu-proyecto.vercel.app"

# Opcional: restringir quién puede editar (vacío = cualquier usuario con sesión)
# ALLOWED_EDIT_EMAILS="tu@email.com,otro@email.com"

# Slug del workspace en seed (default embus)
# DEFAULT_TENANT_SLUG=embus
# TENANT_NAME=EMBUS ADO

# Opcional: enlaces públicos con contraseña
# E2E_PUBLIC_COOKIE_SECRET="secreto-largo-aleatorio"
